# ==============================================================================
# AI Privacy Proxy - Environment Template
# ==============================================================================

# Port server Fastify proxy
PORT=8080
HOST=0.0.0.0

# Upstream AI Provider / Router Base URL default
# (Bisa di-override atau diganti sewaktu-waktu secara instan melalui Portal UI / Dashboard)
UPSTREAM_BASE_URL=https://api.openai.com

# URL Presidio Analyzer Service (Container Docker / Local Python service)
PRESIDIO_URL=http://presidio:5000

# URL Redis Token Vault (Container Docker / Local Redis)
REDIS_URL=redis://redis:6379

# Privacy Operating Mode:
# - strict   : (Fail-Closed) Tolak request jika Presidio/Redis offline untuk proteksi maksimal.
# - balanced : (Fail-Open) Lanjut dengan regex engine lokal jika service Presidio offline.
# (Bisa diubah via UI di menu Settings)
PRIVACY_MODE=strict

# Ephemeral Token Vault TTL (dalam detik)
# 3600 = 1 jam, 86400 = 24 jam.
# (Bisa diatur via slider di Portal UI)
VAULT_TTL_SECONDS=3600

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Admin API Key untuk proteksi Portal Dashboard (/admin/* routes)
# Silakan ganti dengan secret string yang aman
ADMIN_API_KEY=admin-secret-key-change-me
